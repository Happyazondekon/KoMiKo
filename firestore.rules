rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────

    /// True si l'utilisateur est le compte officiel admin Komiko.
    function isKomikoAdmin() {
      return request.auth != null && (
        request.auth.uid == 'UK42noQ7qiVt63v3PHHywdZQajS2' ||
        request.auth.token.email == 'contact@komiko.app'
      );
    }

    /// True si l'utilisateur a le badge vérifié.
    function isVerifiedUser() {
      return request.auth != null &&
        ('isVerified' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerified == true;
    }

    // ── Users & Social Graph ────────────────────────────────────────────────
    match /users/{userId} {
      // Lecture autorisée pour tous les connectés
      allow read: if request.auth != null;

      // Création : seulement par l'utilisateur lui-même
      allow create: if request.auth != null && request.auth.uid == userId;

      // Mise à jour :
      allow update: if request.auth != null && (
        // Admin Komiko peut tout modifier (bannir, restreindre, vérifier, pro)
        isKomikoAdmin()
        ||
        // Cas 1 : Propriétaire modifiant son profil (Bio, Nom, Avatar, Pro, etc.)
        (request.auth.uid == userId && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        ))
        ||
        // Cas 2 : Un tiers qui s'abonne (autorisé à modifier UNIQUEMENT followersCount)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount']))
      );

      allow delete: if isKomikoAdmin();

      // Sous-collection des abonnements (les gens que je suis)
      match /following/{followedId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Sous-collection des abonnés (les gens qui me suivent)
      match /followers/{followerId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == followerId;
      }
    }

    // ── Config (daily joke, app settings) ──────────────────────────────────
    match /config/{document} {
      allow read: if true;
      allow write: if isKomikoAdmin() || isVerifiedUser();
    }

    // ── Jokes ───────────────────────────────────────────────────────────────
    match /jokes/{jokeId} {
      // Les blagues sont lisibles publiquement
      allow read: if true;

      // N'importe quel utilisateur connecté peut poster une blague
      allow create: if request.auth != null;

      // Mise à jour :
      // - L'auteur peut modifier sa propre blague
      // - L'admin Komiko peut tout modifier (vedette, masquage...)
      // - N'importe quel utilisateur connecté peut liker, commenter ou signaler (flag)
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.authorId
        ||
        isKomikoAdmin()
        ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likesCount', 'likedBy', 'commentsCount', 'reportCount', 'isFeatured', 'isHidden'])
      );

      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.authorId
        || isKomikoAdmin()
        || isVerifiedUser()
      );
    }

    // ── Notifications ───────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.recipientId;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.recipientId || isKomikoAdmin());
    }

    // ── Comments ────────────────────────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if true;

      // N'importe quel connecté peut poster un commentaire
      allow create: if request.auth != null;

      // L'auteur ou l'admin peut modifier
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.authorId
        || isKomikoAdmin()
      );

      // L'auteur ou l'admin peut supprimer
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.authorId
        || isKomikoAdmin()
        || isVerifiedUser()
      );
    }

    // ── Reports ─────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, delete: if isKomikoAdmin();
    }

  }
}
